<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>operon</string>
    <key>CFBundleIdentifier</key>
    <string>run.operon.desktop</string>
    <key>CFBundleName</key>
    <string>Operon</string>
    <key>CFBundleDisplayName</key>
    <string>Operon Automation</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0-rc.1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>

    <!-- URL Scheme Registration -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>run.operon.scheme</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>operon</string>
            </array>
        </dict>
    </array>

    <!-- macOS Finder Services Integration -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Operon: Clean Tracking URLs</string>
            </dict>
            <key>NSMessage</key>
            <string>cleanUrlService</string>
            <key>NSPortName</key>
            <string>Operon</string>
            <key>NSSendTypes</key>
            <array>
                <string>public.utf8-plain-text</string>
                <string>NSStringPboardType</string>
            </array>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Operon: Organize Folder</string>
            </dict>
            <key>NSMessage</key>
            <string>organizeFolderService</string>
            <key>NSPortName</key>
            <string>Operon</string>
            <key>NSSendFileTypes</key>
            <array>
                <string>public.folder</string>
            </array>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Operon: Strip Image Metadata</string>
            </dict>
            <key>NSMessage</key>
            <string>stripExifService</string>
            <key>NSPortName</key>
            <string>Operon</string>
            <key>NSSendFileTypes</key>
            <array>
                <string>public.image</string>
                <string>public.jpeg</string>
                <string>public.png</string>
            </array>
        </dict>
    </array>

    <!-- Transparent Permission Disclosures -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Operon requires AppleEvents to coordinate automated file and clipboard workflows.</string>
    <key>NSSystemAdministrationUsageDescription</key>
    <string>Operon requires permission to organize and clean files across directories.</string>
</dict>
</plist>
